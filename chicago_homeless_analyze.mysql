-- QUERY: distribution of homelessness by gender and ethnicity 
SELECT
g.gender_count AS total_homeless_by_gender,
gc.gender_name,
hd.gender_race_count AS total_homeless_by_gender_race,
rec.race_ethnicity_name,
y.year
FROM Gender AS g
JOIN Gender_categories AS gc ON gc.gender_namePK = g.gender_nameFK
JOIN Homeless_Demographics AS hd ON hd.gender_nameFK = gc.gender_namePK
JOIN Race_ethnicity_categories AS rec ON rec.race_ethnicity_namePK = hd.race_ethnicity_nameFK
JOIN Years AS y ON y.yearPK = g.yearFK
WHERE g.yearFK = hd.yearFK
AND g.gender_nameFK = hd.gender_nameFK
AND gc.gender_namePK = hd.gender_nameFK
AND rec.race_ethnicity_namePK = hd.race_ethnicity_nameFK;



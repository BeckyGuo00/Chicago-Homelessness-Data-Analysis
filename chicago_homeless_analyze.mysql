-- CREATE DATABASE homeless_analyze;
USE homeless_analyze;

-- create Years table
DROP TABLE if EXISTS Years;
CREATE TABLE Years(
    yearPK INT NOT NULL PRIMARY KEY AUTO_INCREMENT,
    year INT NOT NULL
);
INSERT INTO Years (year) VALUES
(2014),
(2019),
(2023);

SELECT * FROM Years;


-- create whole American homelessness people table
DROP TABLE if EXISTS US_homeless_count;
CREATE TABLE US_homeless_count(
    us_countPK INT NOT NULL PRIMARY KEY AUTO_INCREMENT,
    us_count INT NULL,
    yearFK INT NULL
);
INSERT INTO US_homeless_count (us_count, yearFK) VALUES
(576450, 1),
(567715, 2),
(653104, 3);

SELECT * FROM US_homeless_count;


-- create Chicago homelessness people table
DROP TABLE if EXISTS Chicago_homeless_count;
CREATE TABLE Chicago_homeless_count(
    chi_countPK INT NOT NULL PRIMARY KEY AUTO_INCREMENT,
    chi_count INT NULL,
    yearFK INT NULL
);
INSERT INTO Chicago_homeless_count (chi_count, yearFK) VALUES
(6294, 1),
(5290, 2),
(6139, 3);

SELECT * FROM Chicago_homeless_count;


-- QUERY: us homelessness_Chicago homelessness ratio
SELECT 
u.us_count, 
c.chi_count, 
CONCAT(ROUND((c.chi_count/u.us_count)*100, 2), '%') AS us_Chicago_homelessness_ratio
FROM US_homeless_count AS u
JOIN Chicago_homeless_count AS c ON u.yearFK = c.yearFK;


-- create Chicago population table
DROP TABLE if EXISTS Chicago_population;
CREATE TABLE Chicago_population(
    chi_populationPK INT NOT NULL PRIMARY KEY AUTO_INCREMENT,
    chi_population INT NULL,
    yearFK INT NULL
);
INSERT INTO Chicago_population (chi_population, yearFK) VALUES
(2726800, 1),
(2691497, 2),
(2664452, 3);

SELECT * FROM Chicago_population;


-- QUERY:Chicago population_Chicago homelessness_ratio
SELECT 
c.chi_count, 
cp.chi_population, 
CONCAT(ROUND((c.chi_count/cp.chi_population)*100, 3), '%') AS Chicago_population_homelessness_ratio
FROM Chicago_population AS cp
JOIN Chicago_homeless_count AS c ON cp.yearFK = c.yearFK;



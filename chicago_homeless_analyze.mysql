SELECT * FROM Owner_Occupied;


-- QUERY:create homeless_ratio query,
SELECT 
r.renter_occipied, 
CONCAT(ROUND(r.rental_rate*100, 3), '%') AS owner_rate,
o.owner_occipied, 
CONCAT(ROUND(o.owner_rate*100, 3), '%') AS owner_rate,
chc.chi_count,
CONCAT(ROUND((chc.chi_count/(r.renter_occipied/r.rental_rate))*100, 2), '%') AS homeless_ratio,
r.yearFK
FROM Renter_Occupied AS r
JOIN Owner_Occupied AS o ON o.yearFK = r.yearFK
JOIN Chicago_homeless_count AS chc ON chc.yearFK = r.yearFK;



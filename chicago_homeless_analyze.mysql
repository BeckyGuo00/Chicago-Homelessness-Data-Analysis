CREATE TABLE Owner_Occupied(
    owner_occipiedPK INT NOT NULL PRIMARY KEY AUTO_INCREMENT,
    owner_occipied INT NULL,
    owner_rate FLOAT NULL,
    yearFK INT NULL
);

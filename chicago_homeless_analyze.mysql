-- QUERY: compare with homeless count and the income ranges
SELECT 
rb.rent_burden_count,
a.ami,
i.irt,
y.year
FROM Rent_Burden AS rb
JOIN Income_rent_ratio AS i ON i.irtPK = rb.irtFk
JOIN Area_median_income AS a ON a.amiPK = rb.amiFK
JOIN Years AS y ON y.yearPK = rb.yearFK
ORDER BY irtFK, amiFK, rent_burden_count, yearFK DESC;


